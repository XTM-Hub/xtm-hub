{
  "name": "@xtm-hub/backend",
  "version": "1.260622.0",
  "description": "Portal API",
  "main": "src/index.js",
  "repository": "https://github.com/FiligranHQ/cloud-portal",
  "author": "Filigran",
  "license": "Filigran",
  "type": "module",
  "private": true,
  "scripts": {
    "copy": "cpy ./src/**/*.graphql dist/ && cpy ./src/migrations/*.js dist/",
    "check-ts": "tsc --noEmit",
    "generate:ts": "graphql-codegen-esm --config codegen.yml",
    "generate:module": "tsx src/scripts/generate-new-module.ts",
    "knex:run": "NODE_OPTIONS='--import tsx' knex --knexfile knexfile.ts",
    "migrate:make": "yarn knex:run migrate:make",
    "migrate:latest": "yarn knex:run migrate:latest",
    "migrate:up": "yarn knex:run migrate:up",
    "migrate:down": "yarn knex:run migrate:down",
    "esmigrate:run": "NODE_OPTIONS='--import tsx' node es-migrate.ts",
    "esmigrate:make": "migrate create --template-file ./src/thirdparty/elasticsearch/migration-template.js --migrations-dir src/es-migrations",
    "esmigrate:up": "yarn esmigrate:run up",
    "esmigrate:down": "yarn esmigrate:run down",
    "seed:make": "yarn knex:run seed:make",
    "generate-pg-to-ts": "NODE_OPTIONS='--import tsx' kanel",
    "build": "yarn copy && node builder/prod/prod.js",
    "start": "LOCAL_DEV=true node dist/index.js",
    "start-tsx": "LOCAL_DEV=true tsx --watch src/index.ts --clear-screen=false",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --watch dist/index.js",
    "start-dev": "concurrently \"yarn dev:tsc\" \"yarn start-tsx\" \"yarn watch:graphql\"",
    "dev": "yarn start-dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "VITEST_MODE=true && vitest run",
    "test:perf": "RUN_PERF_TESTS=true vitest run **/*.perf.test.ts",
    "test:coverage": "yarn test --coverage",
    "test:ci": "yarn check-ts && yarn lint && yarn test --coverage --coverage.clean=false",
    "seed:make:test": "VITEST_MODE=true && yarn knex:run seed:make",
    "start-dev-test": "VITEST_MODE=true && START_DEV_SERVER=true && yarn start-dev",
    "start-dev-e2e-test": "yarn clean-db-test && VITEST_MODE=true && START_DEV_SERVER=true && DATA_SEEDING=true && yarn start-dev",
    "test:w": "VITEST_MODE=true && vitest",
    "init-db-test": "VITEST_MODE=true tsx tests/script/create-database.ts",
    "clean-db-test": "VITEST_MODE=true tsx tests/script/clean-database.ts",
    "watch:graphql": "node builder/dev/watch-graphql.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/lib-storage": "3.1121.0",
    "@elastic/elasticsearch": "8.19.2",
    "@graphql-codegen/plugin-helpers": "5.1.1",
    "@graphql-tools/load-files": "7.0.1",
    "@graphql-tools/merge": "9.2.3",
    "@graphql-tools/schema": "10.1.0",
    "@graphql-tools/utils": "11.2.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@vitest/eslint-plugin": "1.6.27",
    "apollo-errors": "1.9.0",
    "auth0": "5.14.1",
    "body-parser": "2.3.0",
    "config": "4.4.2",
    "cors": "2.8.6",
    "dataloader": "2.2.3",
    "express": "5.2.1",
    "express-prom-bundle": "8.0.0",
    "express-rate-limit": "8.6.2",
    "express-session": "1.19.0",
    "glob": "13.0.6",
    "graphql": "catalog:",
    "graphql-relay": "0.10.2",
    "graphql-sse": "catalog:",
    "graphql-subscriptions": "3.0.0",
    "graphql-upload": "17.1.0",
    "handlebars": "4.7.9",
    "jwt-decode": "4.0.0",
    "knex": "catalog:",
    "migrate": "^2.1.0",
    "node-cron": "4.6.0",
    "nodemailer": "9.0.5",
    "openid-client": "6.8.7",
    "passport": "0.7.0",
    "pg": "catalog:",
    "pg-boss": "12.27.0",
    "prom-client": "15.1.3",
    "uuid": "catalog:",
    "winston": "3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "catalog:",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-resolvers": "4.5.2",
    "@types/cors": "2.8.19",
    "@types/express-session": "1.19.0",
    "@types/graphql-upload": "17.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.1",
    "@types/passport": "1.0.17",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/coverage-v8": "catalog:",
    "chokidar": "5.0.0",
    "concurrently": "catalog:",
    "cpy-cli": "7.0.0",
    "esbuild": "0.28.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jest": "29.16.6",
    "globals": "catalog:",
    "kanel": "4.0.4",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
