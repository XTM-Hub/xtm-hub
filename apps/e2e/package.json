{
  "name": "@xtm-hub/test_e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:demo": "playwright test --config=playwright.demo.config.ts",
    "generate-test-e2e": "npx playwright codegen http://localhost:3002/",
    "test:e2e:update-snapshot": "playwright test --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "prettier:format": "prettier --write ."
  },
  "dependencies": {
    "knex": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "graphql": "catalog:",
    "graphql-tag": "2.12.7",
    "monocart-reporter": "catalog:",
    "playwright-ctrf-json-reporter": "0.0.29",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "bracketSameLine": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "singleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "singleAttributePerLine": true
  }
}
