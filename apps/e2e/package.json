{
  "name": "@xtm-hub/test_e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:demo": "playwright test --config=playwright.demo.config.ts",
    "generate-test-e2e": "npx playwright codegen http://localhost:3002/",
    "test:e2e:update-snapshot": "playwright test --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "prettier:format": "prettier --write ."
  },
  "dependencies": {
    "knex": "catalog:",
    "pg": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "1.65.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "graphql": "catalog:",
    "graphql-tag": "2.12.7",
    "monocart-reporter": "catalog:",
    "playwright-ctrf-json-reporter": "0.3.0",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba",
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "bracketSameLine": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "singleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "singleAttributePerLine": true
  }
}
