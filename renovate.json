{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":semanticCommits",
    "config:recommended"
  ],
  "labels": [
    "dependencies",
    "filigran team"
  ],
  "ignorePaths": [
    "chart/**"
  ],
  "prConcurrentLimit": 5,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "3 days",
  "timezone": "Europe/Paris",
  "schedule": [
    "* 0-4,22-23 * * 1-5",
    "* * * * 0,6"
  ],
  "packageRules": [
    {
      "description": "Major updates wait 1 month before being proposed",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "batch non-major update of dev dependencies",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "devDependencies (non-major)",
      "groupSlug": "dev-dependencies-non-major"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "elasticsearch",
        "docker.elastic.co/elasticsearch/elasticsearch",
        "docker.elastic.co/kibana/kibana"
      ],
      "enabled": false,
      "description": "Ignore Elasticsearch Docker image updates"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "enabled": false,
      "description": "Ignore all Docker Compose file updates"
    },
    {
      "description": "Update AWS SDK v3 every 2 weeks only",
      "matchPackagePatterns": ["^@aws-sdk/"],
      "schedule": ["* * 1 * *"]
    },
    {
      "description": "Keep graphql-request on v6",
      "matchPackageNames": [
        "graphql-request"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "Keep selectolax on 1.0.0: 1.0.1 makes mkdocs-glightbox drop every documentation image",
      "matchPackageNames": [
        "selectolax"
      ],
      "allowedVersions": "1.0.0"
    },
    {
      "description": "Allow only major version 8 for @elastic/elasticsearch",
      "matchPackageNames": [
        "@elastic/elasticsearch"
      ],
      "allowedVersions": ">=8.0.0 <9.0.0"
    }
  ],
  "lockFileMaintenance": {
    "schedule": ["* 5 * * 0"],
    "rebaseWhen": "behind-base-branch",
    "automerge": false,
    "enabled": true
  }
}
