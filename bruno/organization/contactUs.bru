meta {
  name: contactUs
  type: graphql
  seq: 2
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: none
}

headers {
  XTM-Hub-Platform-Id: {{platformId}}
  XTM-Hub-Platform-Token: {{platformToken}}
  ~XTM-Hub-Platform-Assertion: {{platformAssertion}}
  ~cookie: {{cookie}}
}

body:graphql {
  mutation ContactUs($message: String) {
    contactUs(message: $message) {
      success
    }
  }
}

body:graphql:vars {
  {
    "message": "Please contact me"
  }
}

docs {
  Sends a message to the sales team. With a session cookie (disabled here), the contact is the Hub user. Without one,
  only a platform can send it, and the contact is the requester of its trial or the user who registered it.

  A platform sends either the assertion header or the token headers:
  - XTM-Hub-Platform-Assertion (disabled here): a JWS signed by the key the platform enrolled, sent once only.
  - XTM-Hub-Platform-Id and XTM-Hub-Platform-Token, for a trial or a platform that has not enrolled a key yet.

  At most five messages per hour per platform. Answers INVALID_PLATFORM_TOKEN without credentials or when they match
  nothing, PLATFORM_ASSERTION_INVALID or PLATFORM_KEY_MISMATCH for a refused assertion, and PLATFORM_TOKEN_REFUSED for
  the token of a platform that enrolled a key.
}
