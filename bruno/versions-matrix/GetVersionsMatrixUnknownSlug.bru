meta {
  name: Get versions matrix - unknown connector slug
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/opencti/versions-matrix?connector_slugs=not-a-real-connector
  body: none
  auth: none
}

params:query {
  connector_slugs: not-a-real-connector
}

assert {
  res.status: eq 400
}

docs {
  A requested slug that doesn't exist at all (not a known decoupled
  connector) is rejected with 400, unlike the default "all connectors" case
  which never errors on missing connectors.
  
  Response: { "code": 400, "message": "Unknown connector slug(s): not-a-real-connector" }
}
