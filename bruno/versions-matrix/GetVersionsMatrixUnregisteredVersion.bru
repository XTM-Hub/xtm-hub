meta {
  name: Get versions matrix - unregistered version
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/opencti/versions-matrix?version=1.0.0 
  body: none
  auth: none
}

params:query {
  version: 1.0.0 
}

assert {
  res.status: eq 404
  res.body.code: eq 404
}

docs {
  A well-formed `version` that was never registered for the product (see
  GET /opencti/versions, which lists what's actually registered) is
  rejected with 404, distinct from "Invalid version format": the string is
  syntactically valid, it's simply unknown to this product.
  
  Response: { "code": 404, "message": "Unknown opencti version: 1.0.0" }
}
