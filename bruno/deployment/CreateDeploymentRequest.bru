meta {
  name: CreateDeploymentRequest
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: inherit
}

headers {
  cookie: {{cookie}}
}

body:graphql {
  mutation CreateDeploymentRequest($input: CreateDeploymentRequestInput!) {
    createDeploymentRequest(input: $input) {
      id
      platform_identifier
      region
      type
      hub_status
      ordering
      requester_email
      organization_requester_id
      service_instance_id
      organization_name
      request_date
      counts_in_orga_quota
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "products": ["xtmone", "opencti", "openaev"],
      "region": "eu_west",
      "job_title": "ciso_cso_cio",
      "activity_sector": "computer_network_security",
      "use_cases_by_product": [
        { "platform_identifier": "opencti", "use_case": "threat_hunting" },
        { "platform_identifier": "openaev", "use_case": "oaev_purple_team" }
      ],
      "source": "xtmhub"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Ensure cookie is defined in environment

  Creates an XTM Platform bundle trial: one bundle deployment request plus one child trial for each of XTM One, OpenCTI and OpenAEV.

  input.products: deprecated and ignored — the server always embarks xtmone, opencti and openaev
  input.use_cases_by_product: exactly one use case for opencti and one for openaev (none for xtmone)
  input.region: DeploymentRequestPlatformRegion (eu_west, us_east, apac_au, apac_sg)
  input.source: DeploymentRequestSource (xtmhub, opencti_demo, openaev_demo)
}
