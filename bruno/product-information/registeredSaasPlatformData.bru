meta {
  name: registeredSaasPlatformData
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: inherit
}

headers {
  cookie: {{cookie}}
}

body:graphql {
  query RegisteredSaasPlatformData($input: RegisteredSaasPlatformDataInput!) {
    registeredSaasPlatformData(input: $input) {
      metadata {
        hostname
        plan
        start_date
        end_date
        region
      }
      metrics {
        start
        end
        resolution
        series {
          metric_type
          points {
            timestamp
            value
          }
        }
      }
      storage {
        es_used_size {
          percent
          used
          limit
        }
        s3_used_size {
          percent
          used
          limit
        }
      }
      sla {
        target
        months {
          month
          availability
          days {
            day
            availability
          }
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "service_instance_id": "",
      "metrics_period": "last_90_days"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Set service_instance_id to the service instance of a registered SaaS platform of your organization, and metrics_period to last_30_days, last_90_days or last_180_days.
}
