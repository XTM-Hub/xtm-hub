meta {
  name: autoregister
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: inherit
}

headers {
  XTM-Hub-Platform-Token: 
  XTM-Hub-Platform-Id: {{platformId}}
  ~XTM-Hub-Platform-Assertion: {{platformAssertion}}
}

body:graphql {
  mutation AutoRegisterPlatform($platform: PlatformInput!) {
    autoRegisterPlatform(platform: $platform) {
      success
    }
  }
}

body:graphql:vars {
  {
    "platform": {
      "contract": "",
      "id": "{{platformId}}",
      "title": "",
      "url": "",
      "version": ""
    }
  }
}

script:pre-request {
  bru.setVar("platformId", "");
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Fill the values in variables.
  In script/pre-request, set the correct value for platformId
  in Headers, set the platform token
  
  A platform sends either the assertion header or the token headers, never both on purpose: with
  XTM-Hub-Platform-Assertion (a JWS signed by the key it enrolled, disabled here), the token headers are ignored and a
  refused assertion is never retried as a token. A platform that enrolled a key gets PLATFORM_TOKEN_REFUSED for its
  token. This mutation still reads the platform token of a trial deployment, so it needs the token headers today.
}
