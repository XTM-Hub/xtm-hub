meta {
  name: registeredPlatformByPlatformId
  type: graphql
  seq: 2
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: inherit
}

headers {
  cookie: {{cookie}}
}

body:graphql {
  query RegisteredPlatformRedirectTarget(
    $input: RegisteredPlatformByPlatformIdInput!
  ) {
    registeredPlatformByPlatformId(input: $input) {
      service_instance_id
      identifier
      deployment_request {
        parent_id
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "identifier": "openaev",
      "platformId": "",
      "tenantId": null
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Active registration of one platform tenant in the selected organization of the session user, or null.
  A null tenantId matches only a registration without tenant; the OpenAEV default tenant also finds the legacy
  tenant-less registration.
}
