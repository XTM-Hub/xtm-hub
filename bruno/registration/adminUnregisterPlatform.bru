meta {
  name: adminUnregisterPlatform
  type: graphql
  seq: 4
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: inherit
}

headers {
  cookie: {{cookie}}
}

body:graphql {
  mutation AdminUnregisterPlatform($serviceInstanceId: ServiceInstanceId!) {
    adminUnregisterPlatform(serviceInstanceId: $serviceInstanceId) {
      success
    }
  }
}

body:graphql:vars {
  {
    "serviceInstanceId": ""
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Platform admin (BYPASS) only. Sets an active registration to inactive and mails the admins of its organization,
  without being a member of that organization. Does nothing on an inactive registration.
  An explicit unregister: until the platform is connected again, a user who may manage platform registrations in
  another organization can connect it to that organization. An inactive registration that no explicit unregister caused
  (connectivity check, platform reported removed) stays with its owner organization.
  Refused with PLATFORM_NOT_REGISTERED on a registration the admin list does not show (disabled service instance).
  Refused with TRIAL_PLATFORM_CANNOT_BE_UNREGISTERED on a trial: a registration whose contract is trial, or whose service
  instance has a trial deployment request.
}
