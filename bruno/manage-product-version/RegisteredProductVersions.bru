meta {
  name: RegisteredProductVersions
  type: graphql
  seq: 2
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: none
}

body:graphql {
  query RegisteredProductVersions($product: PlatformIdentifier!, $search: String) {
    registeredProductVersions(product: $product, search: $search) {
      product
      version
      created_at
    }
  }
}

body:graphql:vars {
  {
    "product": "opencti",
    "search": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Public query, no auth required.

  Fill variables:
  product: PlatformIdentifier enum value (e.g. opencti, openaev). Required.
  search: optional case-insensitive substring match on the version string (e.g. "6.4").

  Returns at most the 5 latest matching versions, most recent first.
}
